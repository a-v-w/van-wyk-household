# Local Postgres. `npm run db:setup` (also run automatically before `npm run dev`)
# creates this database if it does not exist and applies migrations.
# No user/password: the pg driver falls back to your OS user, which is how
# Homebrew Postgres is set up by default.
DATABASE_URL=postgresql://localhost:5432/van_wyk_household

# On Vercel, set DATABASE_URL to the Neon connection string (the Neon
# integration does this for you). Hosts ending in .neon.tech automatically use
# the Neon HTTP driver. Force a driver with DATABASE_DRIVER=neon|pg if needed.

# Signs the session cookie. Any long random string; generate one with
# `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`.
# Changing it signs everybody out.
AUTH_SECRET=change-me-to-a-long-random-string

# Email reminders (optional). Without these the app still works: the in-app
# banner on lock day does the same job, and the reminder route reports that
# email is not configured instead of failing.
# RESEND_API_KEY=re_xxxxxxxx
# NOTIFY_FROM_EMAIL=household@yourdomain.com

# Protects /api/reminders so only the cron can trigger it. Vercel Cron sends
# this automatically as `Authorization: Bearer <CRON_SECRET>`.
# CRON_SECRET=another-long-random-string

# Used only by `node scripts/db/seed-admin.mjs`, which prompts when they are
# missing. Do not commit real values.
# HOUSEHOLD_NAME=van Wyk household
# ADMIN_NAME=Your Name
# ADMIN_EMAIL=you@example.com
# ADMIN_PASSWORD=
