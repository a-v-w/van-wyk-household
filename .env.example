# Local Postgres. `npm run db:setup` (also run automatically before `npm run dev`)
# creates this database if it does not exist and applies migrations.
# No user/password: the pg driver falls back to your OS user, which is how
# Homebrew Postgres is set up by default.
DATABASE_URL=postgresql://localhost:5432/van_wyk_household

# On Vercel, set DATABASE_URL to the Neon connection string (the Neon
# integration does this for you). Hosts ending in .neon.tech automatically use
# the Neon HTTP driver. Force a driver with DATABASE_DRIVER=neon|pg if needed.
